+/**
+ * Embed bridge for Inno Agent (patched into vendored PPTist).
+ *
+ * When the URL carries ?embed=1 the app talks postMessage with the host page:
+ *   host → iframe  { type: 'pptist:load', buffer: ArrayBuffer, name }   load pptx bytes
+ *   host → iframe  { type: 'pptist:export' }                            export current deck
+ *   iframe → host  { type: 'pptist:ready' }                             sent once on boot
+ *   iframe → host  { type: 'pptist:loaded' }                            import finished
+ *   iframe → host  { type: 'pptist:exported', buffer: ArrayBuffer }     pptx bytes
+ * All traffic is same-origin (the bundle is served from the same app).
+ */
+import useImport from '@/hooks/useImport'
+import useExport from '@/hooks/useExport'
+import { useSlidesStore } from '@/store'
+import { storeToRefs } from 'pinia'
+
+declare global {
+  interface Window {
+    __pptistCaptureExport?: (blob: Blob) => void
+  }
+}
+
+export function setupEmbed() {
+  const params = new URLSearchParams(location.search)
+  if (!params.has('embed')) return
+
+  // Host origin: explicit parentOrigin param (cross-origin embedding/tests),
+  // otherwise same-origin.
+  const origin = params.get('parentOrigin') || window.location.origin
+
+  window.addEventListener('message', (e) => {
+    if (e.origin !== origin && e.origin !== window.location.origin) return
+    const data = e.data
+    if (!data || typeof data !== 'object') return
+
+    if (data.type === 'pptist:load' && data.buffer) {
+      const file = new File([data.buffer], data.name || 'deck.pptx', {
+        type: 'application/vnd.openxmlformats-officedocument.presentationml.presentation',
+      })
+      const { importPPTXFile } = useImport()
+      importPPTXFile([file], { cover: true })
+      // The importer is async but uninstrumented; tell the host it can stop
+      // showing the spinner once the store reflects slides.
+      const slidesStore = useSlidesStore()
+      const stop = slidesStore.$subscribe(() => {
+        window.parent.postMessage({ type: 'pptist:loaded' }, origin)
+        stop()
+      })
+    }
+
+    if (data.type === 'pptist:export') {
+      const slidesStore = useSlidesStore()
+      const { slides } = storeToRefs(slidesStore)
+      const { exportPPTX } = useExport()
+      window.__pptistCaptureExport = (blob: Blob) => {
+        window.__pptistCaptureExport = undefined
+        blob.arrayBuffer().then((buffer) => {
+          window.parent.postMessage({ type: 'pptist:exported', buffer }, origin, [buffer])
+        })
+      }
+      exportPPTX(slides.value, true, false)
+    }
+  })
+
+  window.parent.postMessage({ type: 'pptist:ready' }, origin)
+}
